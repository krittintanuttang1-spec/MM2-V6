--========================================
-- NOCLIP
--========================================

local function SetNoclip(Value)
    NoclipEnabled = Value

    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    if Value then
        NoclipConnection = RunService.Stepped:Connect(function()
            local Character = GetCharacter()
            if not Character then return end

            for _, Part in ipairs(Character:GetDescendants()) do
                if Part:IsA("BasePart") then
                    Part.CanCollide = false
                end
            end
        end)
    else
        local Character = GetCharacter()
        if Character then
            for _, Part in ipairs(Character:GetDescendants()) do
                if Part:IsA("BasePart") then
                    Part.CanCollide = true
                end
            end
        end
    end
end

PlayerTab:CreateToggle({
    Name = "Noclip",
    CurrentValue = false,
    Callback = function(Value)
        PlayClick()
        SetNoclip(Value)
    end
})

--========================================
-- ESP
--========================================

local ESPEnabled = false
local ESPObjects = {}

local function GetRole(Target)
    local Character = Target.Character
    local Backpack = Target:FindFirstChildOfClass("Backpack")

    local function HasTool(Name)
        if Character and Character:FindFirstChild(Name) then
            return true
        end

        if Backpack and Backpack:FindFirstChild(Name) then
            return true
        end

        return false
    end

    if HasTool("Knife") then
        return "Murderer", Color3.fromRGB(255, 50, 50)
    elseif HasTool("Gun") then
        return "Sheriff", Color3.fromRGB(50, 130, 255)
    end

    return "Innocent", Color3.fromRGB(50, 255, 100)
end

local function RemoveESP(Target)
    if ESPObjects[Target] then
        ESPObjects[Target].Highlight:Destroy()
        ESPObjects[Target].Billboard:Destroy()
        ESPObjects[Target] = nil
    end
end

local function AddESP(Target)
    if Target == Player or not Target.Character then return end

    RemoveESP(Target)

    local Character = Target.Character
    local Head = Character:FindFirstChild("Head")
    if not Head then return end

    local Highlight = Instance.new("Highlight")
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.FillTransparency = 0.65
    Highlight.OutlineTransparency = 0
    Highlight.Parent = Character

    local Billboard = Instance.new("BillboardGui")
    Billboard.Size = UDim2.fromOffset(150, 35)
    Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Parent = Head

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.fromScale(1, 1)
    Label.BackgroundTransparency = 1
    Label.TextScaled = true
    Label.Font = Enum.Font.GothamBold
    Label.TextStrokeTransparency = 0.2
    Label.Parent = Billboard

    ESPObjects[Target] = {
        Highlight = Highlight,
        Billboard = Billboard,
        Label = Label
    }
end

local function UpdateESP()
    for _, Target in ipairs(Players:GetPlayers()) do
        if Target ~= Player and Target.Character then
            if not ESPObjects[Target] then
                AddESP(Target)
            end

            local Data = ESPObjects[Target]
            if Data then
                local Role, Color = GetRole(Target)

                Data.Highlight.FillColor = Color
                Data.Highlight.OutlineColor = Color
                Data.Label.Text = Target.Name .. " | " .. Role
                Data.Label.TextColor3 = Color
            end
        end
    end
end

local function ClearESP()
    for Target in pairs(ESPObjects) do
        RemoveESP(Target)
    end
end

ESPTab:CreateToggle({
    Name = "Role ESP",
    CurrentValue = false,
    Callback = function(Value)
        PlayClick()
        ESPEnabled = Value

        if not Value then
            ClearESP()
        end
    end
})

RunService.Heartbeat:Connect(function()
    if ESPEnabled then
        UpdateESP()
    end
end)

Players.PlayerRemoving:Connect(function(Target)
    RemoveESP(Target)
end)

